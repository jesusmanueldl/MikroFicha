<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="3dp"
    app:cardCornerRadius="10dp"
    android:animateLayoutChanges="true"
    app:cardUseCompatPadding="true"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/gradiente_admin4"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical"
            >

            <ImageView
                android:id="@+id/icon_router"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="15dp"
                app:srcCompat="@drawable/ic_baseline_cloud_download_24"
                app:tint="#FFFFFF"></ImageView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/pop_menu"
                android:layout_toEndOf="@+id/icon_router"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txv_titulo_mk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#D81B60"
                    android:paddingHorizontal="10dp"
                    android:text="Nombre"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"></TextView>

                <TextView
                    android:id="@+id/txv_serie_mk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mikrotik | XXXXXXX"
                    android:textColor="#535353"></TextView>

                <TextView
                    android:id="@+id/txv_ip_mk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.5.1 | Hap lite"
                    android:textColor="#535353"></TextView>

                <TextView
                    android:id="@+id/tv_admin_mk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mikrotik | admin"
                    android:textColor="#535353"></TextView>

                <TextView
                    android:id="@+id/txv_version_mk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Version : 6.49 (stable)"
                    android:textColor="#535353"></TextView>

                <TextView
                    android:id="@+id/txv_contrasenia_mk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pass"
                    android:visibility="gone"></TextView>

            </LinearLayout>

            <ImageView
                android:id="@+id/pop_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="5dp"
                app:srcCompat="@drawable/ic_baseline_settings_24"
                app:tint="#535353"></ImageView>


        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>