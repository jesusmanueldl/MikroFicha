<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="15dp"
        android:text="Nuevo IP Binding"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="25dp"
        android:background="@drawable/gradiente_admin3"
        android:textStyle="bold"
        ></TextView>

    <EditText
        android:id="@+id/mac_modal_ipbinding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:hint="Dirección MAC"></EditText>

    <EditText
        android:id="@+id/ip_modal_ipbinding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Drección IP"
        android:layout_margin="15dp"></EditText>

    <EditText
        android:id="@+id/to_modal_ipbinding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="To address"
        android:layout_margin="15dp"></EditText>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="10dp"
        android:textSize="18sp"
        android:text="Servidor"></TextView>

    <Spinner
        android:id="@+id/servidor_spiner_ipbinding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="8dp"></Spinner>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="10dp"
        android:textSize="18sp"
        android:text="Tipo de condición"></TextView>

    <Spinner
        android:id="@+id/tipo_spiner_ipbinding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="8dp"></Spinner>


    <EditText
        android:id="@+id/comentario_modal_ipbinding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Comentario"
        android:layout_margin="15dp"></EditText>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        <Button
            android:id="@+id/btn_agregar_modal_ipbinding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar"
            android:layout_margin="5dp"
            android:backgroundTint="#4961F6"
            ></Button>

        <Button
            android:id="@+id/btn_cancelar_modal_ipbinding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:backgroundTint="#9C9C9C"
            android:layout_margin="5dp"></Button>
    </LinearLayout>




</LinearLayout>