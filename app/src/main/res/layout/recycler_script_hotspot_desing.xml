<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="3dp"
    app:cardCornerRadius="2dp"
    android:animateLayoutChanges="true"
    app:cardUseCompatPadding="true"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/gradiente_admin4"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical"
            >

            <ImageView
                android:id="@+id/icon_router"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="15dp"
                app:srcCompat="@drawable/ic_baseline_extension_24"
                app:tint="#FFFFFF"></ImageView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/pop_menu_script_router"
                android:layout_toEndOf="@+id/icon_router"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titulo_script_router"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="#C0CA33"
                    android:paddingHorizontal="10dp"
                    android:text="titulo"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"></TextView>

                <TextView
                    android:id="@+id/info_script_router"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="info"
                    android:visibility="gone"
                    android:textColor="#535353"></TextView>


                <TextView
                    android:id="@+id/suscripcion_script_router"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#BA00ACC1"
                    android:text="boolean"
                    android:textColor="#FFFFFF"></TextView>

                <TextView
                    android:id="@+id/cmd_script_router"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cmd"
                    android:textColor="#535353"
                    android:visibility="gone"></TextView>


            </LinearLayout>

            <ImageView
                android:id="@+id/pop_menu_script_router"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="5dp"
                android:visibility="invisible"
                app:srcCompat="@drawable/ic_baseline_settings_24"
                app:tint="#535353"></ImageView>


        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>