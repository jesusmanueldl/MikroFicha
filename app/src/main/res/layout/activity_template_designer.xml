<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.gms.ads.AdView
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adViewdisenio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            ads:adSize="SMART_BANNER"
            ads:adUnitId="ca-app-pub-8581380224867392/9792180792">

        </com.google.android.gms.ads.AdView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EDITOR DE PLANTILLAS"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="@color/white"
            android:background="@drawable/gradiente_login1"
            android:textAlignment="center"
            android:layout_marginTop="5dp"
             />

        <ScrollView
            android:id="@+id/designerScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/designerContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Sección: Logo -->
                <TextView
                    android:id="@+id/logoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logo"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp" />

                <ImageView
                    android:id="@+id/logoPreview"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_ticket" />

                <Button
                    android:id="@+id/selectLogoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar Logo"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp" />

                <!-- Propiedades del Logo -->
                <TextView
                    android:id="@+id/logoPropertiesLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Propiedades del Logo"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:background="@drawable/gradiente_admin3"
                    android:textAlignment="center"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/logoWidthEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ancho (ej. 150px)"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/logoHeightEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Alto (ej. auto o 150px)"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/logoBorderRadiusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redondeo del Logo (px)"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBarLogoBorderRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0" />

                <!-- Sección: Fondo -->


                <TextView
                    android:id="@+id/fondoLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fondo"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:background="@drawable/gradiente_admin3"
                    android:textAlignment="center"
                    android:layout_marginTop="16dp" />

                <RadioGroup
                    android:id="@+id/radioGroupBackgroundType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <RadioButton
                        android:id="@+id/radioGradient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gradiente"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/radioImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Imagen"/>
                </RadioGroup>

                <Button
                    android:id="@+id/selectBackgroundImageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar imagen de fondo"
                    android:enabled="false"
                    android:layout_marginTop="8dp"/>

                <!-- Selección de Colores para Fondo -->
                <LinearLayout
                    android:id="@+id/colorSelectorsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/color1Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Color 1:" />

                    <Button
                        android:id="@+id/color1Picker"
                        android:layout_width="111dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="Elegir Color 1" />

                    <TextView
                        android:id="@+id/color2Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="   Color 2:"
                        android:layout_marginLeft="16dp" />

                    <Button
                        android:id="@+id/color2Picker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elegir Color 2"
                        android:layout_marginLeft="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/orientationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orientación del degradado"
                    android:layout_marginTop="16dp" />

                <Spinner
                    android:id="@+id/spinnerOrientation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Sección: Formulario -->
                <TextView
                    android:id="@+id/formularioLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Formulario"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:background="@drawable/gradiente_admin3"
                    android:textAlignment="center"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Título (ej. Login)"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/usernameHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Texto del campo usuario (ej. Usuario)"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/passwordHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Texto del campo contraseña (ej. Contraseña)"
                    android:layout_marginTop="8dp" />

                <!-- Opción para Ocultar la Contraseña -->
                <TextView
                    android:id="@+id/hidePasswordLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ocultar contraseña:"
                    android:layout_marginTop="16dp" />

                <RadioGroup
                    android:id="@+id/radioGroupHidePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioHideNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/radioHideYes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sí" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Oculta la contraseña para usar solo con PIN"
                    android:padding="8dp"
                    android:background="#FFC4F3"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp" />

                <EditText
                    android:id="@+id/footerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Texto del pie de página"
                    android:layout_marginTop="8dp" />

                <!-- Personalización del Formulario -->
                <TextView
                    android:id="@+id/personalizacionFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personalización del formulario"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/inputFontSizeEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tamaño de fuente para inputs (ej. 14px)" />

                <EditText
                    android:id="@+id/inputPaddingEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Padding para inputs (ej. 10px)"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/inputMarginEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Margen para inputs (ej. 5px)"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/formBgColorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color de fondo del formulario"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/formBgColorPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elegir color de fondo"
                    android:layout_marginTop="4dp"/>

                <!-- Redondeo y Bordes del Formulario -->
                <TextView
                    android:id="@+id/formBorderRadiusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redondeo del formulario (px)"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBarFormBorderRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grosor del borde (px)"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBarBorderWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:progress="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color del Borde"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/formBorderColorPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elegir color borde"/>

                <Spinner
                    android:id="@+id/spinnerBorderStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/verticalOffsetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desplazamiento Vertical (ej. 50px o -20px)"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/verticalOffsetEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="50px"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/formWidthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ancho del Formulario (px)"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBarFormWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="800"
                    android:progress="650" />

                <TextView
                    android:id="@+id/formHeightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alto del Formulario (px)"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBarFormHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="600"
                    android:progress="400" />

                <!-- Sección: Botones -->
                <TextView
                    android:id="@+id/botonesLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Botones"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:background="@drawable/gradiente_admin3"
                    android:textAlignment="center"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/buttonColorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color del Botón"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/buttonColorPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elegir color del botón"
                    android:layout_marginTop="4dp" />

                <!-- Texto y estilos del botón -->
                <EditText
                    android:id="@+id/buttonTextEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Texto del botón (ej. Ingresar)"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/buttonTextSizeEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tamaño del texto del botón (ej. 16px)"
                    android:inputType="text" />

                <TextView
                    android:id="@+id/buttonTextColorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color del texto del botón"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/buttonTextColorPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elegir color del texto del botón"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/buttonBorderRadiusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redondeo del Botón (px)"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBarButtonBorderRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="4" />

                <!-- Tamaño del botón -->
                <EditText
                    android:id="@+id/buttonWidthEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ancho del botón (ej. 100px)"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/buttonHeightEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Alto del botón (ej. 40px)"
                    android:inputType="text" />

                <!-- Sección: Vista previa y Exportación -->
                <TextView
                    android:id="@+id/previewLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vista previa"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal">

                    <Button
                        android:id="@+id/editHtmlButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Edit HTML"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        android:id="@+id/syncHtmlButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sync HTML"/>

                </LinearLayout>

                <WebView
                    android:id="@+id/previewWebView"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Una vez que hayas terminado de personalizar tu plantilla, la app te
permite guardar el diseño generado en tu dispositivo en el directorio de
Descargas, dentro se crea un directorio de nombre hotspot. Este
directorio contiene todos los archivo necesario para que MikroTik lo
utilice como plantilla de hotspot. Importante: ⚠️ Actualmente no está habilitada la opción de subir la
plantilla directamente desde la app, por lo que debes usar Winbox para
hacerlo."></TextView>

                <TextView
                    android:id="@+id/textViewPdfLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@android:color/holo_blue_dark"
                    android:padding="16dp"
                    android:textIsSelectable="true"
                    android:clickable="true"
                    android:focusable="true" />

                <Button
                    android:id="@+id/exportButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exportar Plantilla"
                    android:layout_marginTop="16dp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Ver vista previa modal"
        android:src="?android:attr/actionModeFindDrawable"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:backgroundTint="#FF9800"
        app:tint="@android:color/white"
        app:maxImageSize="48dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
