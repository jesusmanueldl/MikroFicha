<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="5dp"
    app:cardCornerRadius="10dp"
    android:animateLayoutChanges="true"
    app:cardUseCompatPadding="true"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/gradiente_admin4"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical"
            >

            <ImageView
                android:id="@+id/icon_router"
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/ic_baseline_receipt_24"
                app:tint="@color/white"></ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="30dp"
                android:layout_toStartOf="@+id/pop_menu_usuario"
                android:layout_toEndOf="@+id/icon_router"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txv_nombre_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#3F51B5"
                    android:text="Nombre"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"></TextView>

                <TextView
                    android:id="@+id/txv_contrasenia_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#3F51B5"
                    android:text="contraseña"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"></TextView>

                <TextView
                    android:id="@+id/txv_servidor_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servidor : hotspot1"
                    android:textColor="#535353"></TextView>

                <TextView
                    android:id="@+id/txv_perfil_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perfil: fijos"
                    android:textColor="#535353"></TextView>

                <TextView
                    android:id="@+id/txv_uptime_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uptime: 14h40m53s"
                    android:textColor="#535353"></TextView>

                <TextView
                    android:id="@+id/txv_comentario_usuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=";;comentario"
                    android:textColor="#535353"></TextView>

            </LinearLayout>

            <ImageView
                android:id="@+id/pop_menu_usuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="5dp"
                app:srcCompat="@drawable/ic_baseline_settings_24"
                app:tint="#535353"></ImageView>


        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>